# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings > API). The URL and anon key are public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for /api/cron/daily. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Email through Resend (resend.com > API Keys). Without a key, emails are skipped and logged.
RESEND_API_KEY=
# Sending address on a domain verified in Resend, e.g. notifications@mail.yourcompany.lk.
# Unset = onboarding@resend.dev (Resend's test sender: it only delivers to your own Resend
# account address, which is fine together with EMAIL_DEV_REDIRECT).
EMAIL_FROM=
# NOT production (anything but VERCEL_ENV=production / APP_ENV=production): EVERY email goes to
# this address instead, with "[DEV]" in the subject and the real recipient named in the text.
# Unset outside production = nothing is sent (logged as skipped). Ignored in production.
EMAIL_DEV_REDIRECT=
# Optional reply-to for emails that are not from a company (owners and admins). Customer emails
# always reply to their company's email.
EMAIL_REPLY_TO=
# Optional: "fake" records emails without sending (tests and e2e set it), "none" turns email off.
EMAIL_TRANSPORT=
# Optional: Resend webhook signing secret (whsec_...). Set it to turn on /api/webhooks/resend
# (bounces and spam complaints mark the email failed and alert the owner).
RESEND_WEBHOOK_SECRET=
# Optional: APP_ENV=production marks a non-Vercel host as production.

# Public base URL of the app, used in emails and links. No trailing slash.
APP_URL=http://localhost:3000

# Direct Postgres connection for database tests (npm run test:db) and for deleting the
# accounts the e2e tests create (npm run test:e2e).
# Project Settings > Database > Connection string (session pooler or direct). Server/dev only.
SUPABASE_DB_URL=
